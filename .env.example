# Copy to .env and fill in. .env is never committed.
# Real keys must never appear in code, tests, or commit messages.

# --- providers ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
RIME_API_KEY=

# --- telemetry (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- gateway ---
# dev | staging | prod. Outside dev, finding `fake` in the pool must abort startup.
APP_ENV=dev

# Comma-separated; order is priority. The router matches names only, never vendor
# semantics. `fake` is FakeProvider (a sine wave) and is allowed in dev only.
TTS_PROVIDER_POOL=fake
TTS_LOG_LEVEL=INFO

# --- bench ---
# Hardware label archived alongside every latency number in a report.
BENCH_HARDWARE_LABEL=
