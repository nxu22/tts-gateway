# 复制成 .env 后填值。.env 不进仓库。
# 真实 key 绝不写进代码、测试或提交信息。

# --- providers ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
RIME_API_KEY=

# --- telemetry (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- gateway ---
# 逗号分隔,顺序即优先级。router 只认名字,不认 vendor 语义。
TTS_PROVIDER_POOL=fake
TTS_LOG_LEVEL=INFO

# --- bench ---
# 跑分报告里必须记录的硬件标识,和延迟数字一起归档。
BENCH_HARDWARE_LABEL=
